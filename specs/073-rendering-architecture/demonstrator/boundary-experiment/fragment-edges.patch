+bool ParagraphImpl::experimentalPadded() const {
+    for (const auto& span : fExperimentalSpans)
+        if (span.horizontalPadding || span.verticalPadding) return true;
+    return false;
+}
+
+std::vector<ParagraphImpl::ExperimentalVisualSlice>
+ParagraphImpl::experimentalVisualSlices(TextRange range) const {
+    std::vector<size_t> indexes;
+    std::vector<SkUnicode::BidiLevel> levels;
+    for (const auto& run : fRuns) {
+        if (run.textRange().start < range.end && range.start < run.textRange().end) {
+            indexes.push_back(run.index());
+            levels.push_back(run.fBidiLevel);
+        }
+    }
+    std::vector<int32_t> order(indexes.size());
+    if (!order.empty()) fUnicode->reorderVisual(levels.data(), levels.size(), order.data());
+    std::vector<ExperimentalVisualSlice> slices;
+    std::vector<SkScalar> padding;
+    for (auto logical : order) {
+        auto index = indexes[logical];
+        const auto& run = fRuns[index];
+        size_t identity = EMPTY_INDEX;
+        SkScalar pad = 0;
+        for (const auto& span : fExperimentalSpans) {
+            if (span.source.start <= std::max(range.start, run.textRange().start) &&
+                std::min(range.end, run.textRange().end) <= span.source.end) {
+                identity = span.identity;
+                pad = span.horizontalPadding;
+                break;
+            }
+        }
+        slices.push_back({index, identity, 0, 0});
+        padding.push_back(pad);
+    }
+    for (size_t i = 0; i < slices.size(); ++i) {
+        if (slices[i].identity == EMPTY_INDEX) continue;
+        if (i == 0 || slices[i-1].identity != slices[i].identity) slices[i].before = padding[i];
+        if (i+1 == slices.size() || slices[i+1].identity != slices[i].identity) slices[i].after = padding[i];
+    }
+    return slices;
+}
+
+SkScalar ParagraphImpl::experimentalPadding(TextRange range) const {
+    SkScalar padding = 0;
+    for (const auto& slice : experimentalVisualSlices(range)) padding += slice.before + slice.after;
+    return padding;
+}
+
+SkScalar ParagraphImpl::experimentalVerticalPadding(TextRange range) const {
+    SkScalar padding = 0;
+    for (const auto& span : fExperimentalSpans)
+        if (span.source.start < range.end && range.start < span.source.end)
+            padding = std::max(padding, span.verticalPadding);
+    return padding;
+}
+
+void ParagraphImpl::experimentalSetSpans(std::vector<ExperimentalFragmentSpan> spans) {
+    bool equal = spans.size() == fExperimentalSpans.size();
+    for (size_t i = 0; equal && i < spans.size(); ++i) {
+        const auto& a = spans[i];
+        const auto& b = fExperimentalSpans[i];
+        equal = a.identity == b.identity && a.source == b.source &&
+                a.horizontalPadding == b.horizontalPadding && a.verticalPadding == b.verticalPadding;
+    }
+    if (equal) return;
+    fExperimentalSpans = std::move(spans);
+    fBidiRegions.clear();
+    fExperimentalGraphemeEdges.clear();
+    fCodeUnitProperties.clear();
+    fPicture = nullptr;
+    fState = kUnknown; // Recompute Unicode flags; old cluster starts must not survive.
+}
