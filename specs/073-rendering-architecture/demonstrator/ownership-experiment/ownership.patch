+void ParagraphImpl::invalidateRunOwners() {
+    fOwnersValid = false;
+    ++fRunRevision;
+    std::vector<size_t>().swap(fRunOwners);
+}
+
+void ParagraphImpl::buildRunOwners() {
+    if (fExperimentalSpans.empty() || fRuns.empty()) return;
+    std::vector<size_t> owners(fRuns.size(), EMPTY_INDEX);
+    for (size_t i = 0; i < size_t(fRuns.size()); ++i) {
+        auto range = fRuns[i].textRange();
+        size_t owner = EMPTY_INDEX;
+        bool split = false;
+        for (size_t j = 0; j < fExperimentalSpans.size(); ++j) {
+            const auto& span = fExperimentalSpans[j];
+            if ((range.start < span.source.start && span.source.start < range.end) ||
+                (range.start < span.source.end && span.source.end < range.end)) split = true;
+            if (owner == EMPTY_INDEX && span.source.start <= range.start && range.end <= span.source.end)
+                owner = j;
+        }
+        owners[i] = split ? kOwnershipLegacy : owner;
+    }
+    fRunOwners.swap(owners);
+    fOwnerRevision = fRunRevision;
+    fOwnersValid = true;
+}
+
+size_t ParagraphImpl::runOwner(size_t index, TextRange range) const {
+    if (fOwnersValid && fOwnerRevision == fRunRevision &&
+        fRunOwners.size() == size_t(fRuns.size()) && index < fRunOwners.size()) {
+        auto owner = fRunOwners[index];
+        if (owner == EMPTY_INDEX || owner < fExperimentalSpans.size()) return owner;
+    }
+    const auto& run = fRuns[index];
+    for (size_t j = 0; j < fExperimentalSpans.size(); ++j) {
+        const auto& span = fExperimentalSpans[j];
+        if (span.source.start <= std::max(range.start, run.textRange().start) &&
+            std::min(range.end, run.textRange().end) <= span.source.end) return j;
+    }
+    return EMPTY_INDEX;
+}
