+std::vector<ParagraphImpl::ExperimentalFragmentIssue>
+ParagraphImpl::experimentalCheckFragmentEdges(
+        const std::vector<ExperimentalFragmentSpan>& spans) const {
+    SkASSERT(fState >= kShaped);
+    std::vector<ExperimentalFragmentIssue> issues;
+    for (const auto& span : spans) {
+        if (span.horizontalPadding == 0) {
+            continue;
+        }
+        // Keep adjacent identities separate, even when their ranges touch.
+        for (auto edge : {span.source.start, span.source.end}) {
+            for (const auto& cluster : fClusters) {
+                const auto range = cluster.textRange();
+                if (range.start < edge && edge < range.end) {
+                    issues.push_back({span.identity, edge, range, cluster.size()});
+                    break;
+                }
+            }
+        }
+    }
+    return issues;
 }

